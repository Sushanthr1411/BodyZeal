# Server
PORT=8080
NODE_ENV=development

# Postgres connection string.
# Local:      postgresql://USER:PASSWORD@localhost:5432/bodyzeal
# Cloud Run:  postgresql://USER:PASSWORD@/bodyzeal?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Must match the frontend's VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# Local dev only — path to a downloaded Firebase service account JSON.
# Leave unset on Cloud Run: the attached service account is used automatically
# (Application Default Credentials), which is why this var is optional here.
GOOGLE_APPLICATION_CREDENTIALS=

# Comma-separated list of allowed browser origins for CORS.
# Local:      http://localhost:5173
# Production: https://<deployed-frontend-domain>
FRONTEND_ORIGINS=http://localhost:5173

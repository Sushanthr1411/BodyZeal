# Server
PORT=8080
NODE_ENV=development

# Postgres connection string.
# Local:      postgresql://USER:PASSWORD@localhost:5432/bodyzeal
# Cloud Run:  postgresql://USER:PASSWORD@/bodyzeal?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Must match the frontend's VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# Local dev only — path to a downloaded Firebase service account JSON.
# Leave unset on Cloud Run: the attached service account is used automatically
# (Application Default Credentials), which is why this var is optional here.
GOOGLE_APPLICATION_CREDENTIALS=

# Server-side only — never sent to the frontend, never logged. Local dev:
# an API key from Google AI Studio (aistudio.google.com/apikey). Cloud Run:
# inject via Secret Manager.
GEMINI_API_KEY=

# Optional — powers the "Need Help?" contact form (Dashboard sidebar), which
# sends the message straight from the app instead of opening the user's own
# mail client. If unset, that form falls back to showing the support email
# with a copy button / mailto link instead of erroring.
# SUPPORT_EMAIL_USER: a Gmail address to send FROM, authenticated via an App
#   Password (myaccount.google.com/apppasswords — requires 2FA enabled on
#   that account). Using teamcollabcore@gmail.com itself is the simplest setup.
# SUPPORT_EMAIL_APP_PASSWORD: the 16-character App Password for that account
#   (NOT the account's normal login password — Gmail rejects that over SMTP).
# SUPPORT_EMAIL_TO: where messages are delivered. Defaults to
#   teamcollabcore@gmail.com if left unset.
SUPPORT_EMAIL_USER=
SUPPORT_EMAIL_APP_PASSWORD=
SUPPORT_EMAIL_TO=teamcollabcore@gmail.com

# Comma-separated list of allowed browser origins for CORS. This is the
# ONLY allowlist in production. In development, any http://localhost:<port>
# is also accepted automatically (see src/app.ts) — Vite bumps its port
# whenever the previous one is still in use, so this value doesn't need to
# track that; it's still checked first and still the right place to add a
# non-localhost dev origin if you ever need one.
# Production: https://<deployed-frontend-domain>
FRONTEND_ORIGINS=http://localhost:5173

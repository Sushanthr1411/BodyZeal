// BodyZeal backend schema — Phase 1.
//
// DailyLogEntry decision (see backend/PHASE1_REPORT.md for the full audit):
// the frontend's quick-log widget (src/lib/todayLog.ts) stores the exact same
// shape as a routine-session entry — { exerciseName/exerciseId, sets, reps,
// weight, volume, loggedAt } — with no fields of its own. It is modeled here
// as a WorkoutSet with a nullable sessionId rather than a separate entity:
// sessionId == null means "logged outside any session" (the dashboard quick
// log), sessionId != null means "logged inside a WorkoutSession". userId is
// stored directly on WorkoutSet (not just inherited via session) specifically
// so quick-log rows — which have no session — still carry ownership and can
// be queried/scoped without a join.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Enums (mirror frontend/src/types/*.ts and profile.ts unions) ----

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum FitnessGoal {
  BUILD_MUSCLE
  LOSE_WEIGHT
  MAINTAIN_FITNESS
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Equipment {
  DUMBBELL
  KETTLEBELL
  BARBELL_ROD
  RESISTANCE_BAND
  CABLE_MACHINE
  MACHINE
  BODYWEIGHT
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  LEGS
  GLUTES
  ABS_CORE
  CALVES
}

enum SessionStatus {
  ACTIVE
  FINISHED
  DISCARDED
}

// ---- Entities ----

model User {
  id          String   @id // Firebase UID — never generated by us, always JIT-provisioned
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile  UserProfile?
  routines Routine[]
  sessions WorkoutSession[]
  sets     WorkoutSet[]

  @@map("users")
}

model UserProfile {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String?
  dateOfBirth     DateTime?        @db.Date
  gender          Gender?
  profilePhotoUrl String?
  heightCm        Float?
  weightKg        Float?
  fitnessGoal     FitnessGoal?
  experienceLevel ExperienceLevel?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("user_profiles")
}

model Exercise {
  id          String      @id // slug, e.g. "barbell-bench-press" — matches frontend/src/data/exercises.ts ids
  name        String
  equipment   Equipment
  muscleGroup MuscleGroup

  routineExercises RoutineExercise[]
  workoutSets       WorkoutSet[]

  @@map("exercises")
}

model Routine {
  id              String   @id @default(uuid())
  userId          String? // null = system default (seeded), owned otherwise
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  isSystemDefault Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  exercises RoutineExercise[]
  sessions  WorkoutSession[]

  @@index([userId])
  @@map("routines")
}

model RoutineExercise {
  id          String   @id @default(uuid())
  routineId   String
  routine     Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  plannedSets Int
  orderIndex  Int

  @@index([routineId])
  @@map("routine_exercises")
}

model WorkoutSession {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  routineId        String?
  routine          Routine?      @relation(fields: [routineId], references: [id])
  name             String
  status           SessionStatus @default(ACTIVE)
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?
  totalVolume      Float         @default(0)
  totalSets        Int           @default(0)
  durationSeconds  Int?
  activeExerciseId String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sets WorkoutSet[]

  @@index([userId, startedAt])
  @@map("workout_sessions")
}

// One logged entry = one exercise x (sets, reps, weight) — matches the
// frontend's WorkoutSet type exactly (sets is a *count*, not a set number).
model WorkoutSet {
  id         String          @id @default(uuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String? // null = dashboard quick-log entry, not part of a session
  session    WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id])
  sets       Int
  reps       Int
  weight     Float
  volume     Float
  loggedAt   DateTime        @default(now())

  @@index([sessionId])
  @@index([userId, loggedAt])
  @@map("workout_sets")
}

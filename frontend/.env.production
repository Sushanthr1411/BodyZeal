# BodyZeal backend API base URL used for production builds (npm run build).
# Vite automatically loads this file in production mode and it overrides
# any value from .env.local. Not a secret — safe to commit.
VITE_API_BASE_URL=https://bodyzeal-backend-717674002673.asia-south1.run.app

# Firebase web client config used for production builds (npm run build).
# These are public client identifiers (not secrets) protected by Firebase
